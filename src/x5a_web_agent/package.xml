<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x5a_web_agent</name>
  <version>0.1.0</version>
  <description>Phone web UI, rule-based command parser, and ROS 2 Action bridge for X5A voice pick-place.</description>
  <maintainer email="user@example.com">x5a user</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>x5a_task_interfaces</depend>
  <depend>x5a_pick_place</depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
