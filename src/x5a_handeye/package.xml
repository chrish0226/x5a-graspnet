<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x5a_handeye</name>
  <version>0.1.0</version>
  <description>Eye-in-hand and eye-to-hand calibration for ARX X5A.</description>
  <maintainer email="user@example.com">x5a user</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <exec_depend>arx5_arm_msg</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>realsense2_camera</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
